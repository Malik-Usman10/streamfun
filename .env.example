# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=streamfun
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Encryption Keys
MASTER_ENCRYPTION_KEY=your_32_byte_hex_key_here
FILE_ENCRYPTION_MASTER_KEY=your_32_byte_hex_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_here
API_KEY_SALT=your_api_key_salt_here

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Worker Configuration
ENABLE_WORKERS=true
TOKEN_REFRESH_INTERVAL=15
HEALTH_CHECK_INTERVAL=10
QUOTA_MONITOR_INTERVAL=30

# File Upload Configuration
MAX_FILE_SIZE=10737418240
CHUNK_SIZE=10485760
MAX_PARALLEL_CHUNKS=3

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
