{
  "name": "streamfun",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-cloud storage backend automation system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "migrate:up": "bun run src/database/migrate.ts up",
    "migrate:down": "bun run src/database/migrate.ts down",
    "migrate:create": "bun run src/database/migrate.ts create"
  },
  "keywords": ["cloud-storage", "multi-cloud", "streaming", "file-management"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.70.4",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^11.0.0",
    "fast-check": "^4.6.0",
    "typescript": "^5.9.3"
  }
}
